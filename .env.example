# Generate a private key (at least 32 characters). Do not commit .env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=inventory-api
JWT_AUDIENCE=inventory-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_EXPIRE_HOURS=12
LOGIN_CONFIRM_EXPIRE_MINUTES=5
PASSWORD_SETUP_EXPIRE_MINUTES=5
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# False only for local HTTP. Set True in production with HTTPS.
AUTH_COOKIE_SECURE=False
